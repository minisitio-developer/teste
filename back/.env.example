# ============================================================
#   MINISITIO — Exemplo de Configuração
#   Copie para .env e preencha os valores reais
#   NUNCA commite o arquivo .env no git!
# ============================================================
#
# Para desenvolvimento local:
#   cp .env.example .env
#   docker compose up -d db
#   npm run dev
#
# Para produção (VPS Hostinger):
#   As variáveis ficam em /opt/minisitio/config/.env.production
#   Esse arquivo NUNCA deve ser versionado no GitHub.
# ============================================================

# ── Servidor ────────────────────────────────────────────────
PORT=3032
NODE_ENV=development

# ── Banco de Dados MySQL ─────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=minisitio_dev

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=coloque_uma_chave_forte_aqui_64_caracteres
JWT_EXPIRE=24h

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── API ──────────────────────────────────────────────────────
API_KEY=sua_api_key_aqui
API_URL=http://localhost:3032/api
API_SECRET=sua_api_secret_forte_aqui
SECRET_KEY_WEBHOOK=seu_webhook_secret_aqui

# ── Mercado Pago — Sandbox ──────────────────────────────────
MP_PUBLIC_KEY_SANDBOX=
MP_ACCESS_TOKEN_SANDBOX=

# ── Mercado Pago — Produção ──────────────────────────────────
MP_PUBLIC_KEY_PROD=
MP_ACCESS_TOKEN_PROD=
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# ── Segurança ────────────────────────────────────────────────
USE_HELMET=false

# ── Logs ─────────────────────────────────────────────────────
LOG_LEVEL=debug
